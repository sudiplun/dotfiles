#!/usr/bin/env bash
# toggle-theme.sh
# Toggle light/dark appearance for both GTK (GNOME) and Qt (KDE) apps
# on a Hyprland session where both desktops' apps coexist.
#
# Usage:
#   ./toggle-theme.sh          # toggle current state
#   ./toggle-theme.sh light    # force light
#   ./toggle-theme.sh dark     # force dark

set -euo pipefail

STATE_FILE="$HOME/.cache/theme-toggle-state"
mkdir -p "$(dirname "$STATE_FILE")"

# ---- Theme names, adjust to taste ----
GTK_LIGHT="Orchis-Light"
GTK_DARK="Orchis-Dark"
ICON_THEME="Adwaita"
PLASMA_LIGHT="BreezeLight"
PLASMA_DARK="BreezeDark"

CURRENT="$(cat "$STATE_FILE" 2>/dev/null || echo light)"

# Allow explicit override: ./toggle-theme.sh light|dark
if [[ "${1:-}" == "light" || "${1:-}" == "dark" ]]; then
    NEW="$1"
else
    [[ "$CURRENT" == "light" ]] && NEW="dark" || NEW="light"
fi

if [[ "$NEW" == "dark" ]]; then
    GTK_THEME="$GTK_DARK"
    COLOR_SCHEME="prefer-dark"
    PLASMA_SCHEME="$PLASMA_DARK"
else
    GTK_THEME="$GTK_LIGHT"
    COLOR_SCHEME="prefer-light"
    PLASMA_SCHEME="$PLASMA_LIGHT"
fi

# ---- GTK / GNOME apps ----
if command -v gsettings &>/dev/null; then
    gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME"
    gsettings set org.gnome.desktop.interface color-scheme "$COLOR_SCHEME"
    gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME"
fi

# ---- Qt / KDE apps (Plasma color scheme, works without full Plasma session) ----
if command -v plasma-apply-colorscheme &>/dev/null; then
    plasma-apply-colorscheme "$PLASMA_SCHEME" || true
fi

# ---- Qt apps using qt5ct/qt6ct instead of Plasma schemes ----
for cfg in "$HOME/.config/qt5ct/qt5ct.conf" "$HOME/.config/qt6ct/qt6ct.conf"; do
    if [[ -f "$cfg" ]]; then
        if [[ "$NEW" == "dark" ]]; then
            sed -i 's/^color_scheme_path=.*/color_scheme_path=darker.conf/' "$cfg"
        else
            sed -i 's/^color_scheme_path=.*/color_scheme_path=/' "$cfg"
        fi
    fi
done

# ---- GTK_THEME env var for apps launched fresh (add to hyprland.conf if you want this persistent) ----
export GTK_THEME="$GTK_THEME"

echo "$NEW" > "$STATE_FILE"

command -v notify-send &>/dev/null && notify-send "Theme" "Switched to $NEW mode"
echo "Switched to $NEW mode"
